    android:focusable="true">

    <View
        android:id="@+id/handle"
        android:layout_width="9dp"
        android:layout_height="80dp"
        android:layout_gravity="start|center_vertical"
        android:background="@drawable/overlay_handle_bg" />

</FrameLayout>