android_app {
    name: "XiaomiParts",
    certificate: "platform",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "org.lineageos.settings.resources",
    ],
}
